# Content Room — environment template
#
# Copy to .env.local and fill in what you have.
#
# IMPORTANT: every key below is OPTIONAL. With none of them set, Content Room
# runs in demo mode using the deterministic engine and the fixture provider.
# A zero-key configuration is a valid configuration, not a broken one.
#
# These are server-only. None is prefixed NEXT_PUBLIC_, so none can enter a
# client bundle. Never log them, never echo them in an error payload.

# ---------------------------------------------------------------------------
# Live model tiers (optional). First available provider in this order wins.
# ---------------------------------------------------------------------------

# Primary. Best quality and best free-tier throughput for a ~50-agent run.
# https://ai.google.dev
GOOGLE_GENERATIVE_AI_API_KEY=

# Fallback. Fast; free plan is roughly 30 RPM / 1K RPD / 8K TPM per model.
# Watch the 8K TPM ceiling on large fan-outs.
# https://console.groq.com
GROQ_API_KEY=

# Second fallback. Note the free tier is 50 requests/day until credits are
# purchased all-time, then 1000/day.
# https://openrouter.ai
OPENROUTER_API_KEY=

# Any OpenAI-compatible endpoint (vLLM, LM Studio, a proxy, ...).
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# ---------------------------------------------------------------------------
# Local-only tier. Cannot work on deployed Vercel serverless.
# https://ollama.com
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/api

# ---------------------------------------------------------------------------
# Content ingestion (optional). Without it, YouTube import uses oEmbed only
# (title, author, thumbnail — no description). 1 unit per call against a
# default 10,000 units/day.
# https://developers.google.com/youtube/v3/determine_quota_cost
# ---------------------------------------------------------------------------
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Runtime limits. Defaults shown; tighten for a live demo.
# ---------------------------------------------------------------------------

# Audience population ceiling. Contract range is 6..60.
CONTENT_ROOM_MAX_AUDIENCE=60

# Run persistence. "file" is LOCAL DEVELOPMENT ONLY — Vercel's serverless
# filesystem is read-only apart from /tmp and is not durable. FileRunStore
# refuses to run when VERCEL is set.
# memory | file
CONTENT_ROOM_RUN_STORE=memory

# Per-hop fetch timeout for URL import (ms). A total wall-clock budget is
# enforced on top of this.
CONTENT_ROOM_FETCH_TIMEOUT_MS=8000

# Response size cap for URL import. Bodies are streamed and aborted past this.
CONTENT_ROOM_MAX_RESPONSE_BYTES=2000000

# Demo scheduling: 1x | 2x | instant. "instant" is used by tests and by a
# presenter who is running out of time.
CONTENT_ROOM_DEMO_SPEED=1x
