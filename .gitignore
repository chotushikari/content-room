node_modules/
.pnp
.pnp.js

# Build output
.next/
out/
build/
dist/
.vercel/

# Test / eval artifacts
coverage/
eval-results/

# Local data (FileRunStore is local-dev only)
.data/

# Environment — never commit secrets
.env
.env.local
.env.*.local
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Python (reserved for the deferred OASIS adapter)
__pycache__/
*.py[cod]
.venv/
venv/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel CLI state
.vercel

# Environment — never commit secrets.
#
# NOTE: the negation MUST come last. Something appended a bare `.env*` below the
# earlier `!.env.example` line, and because the later pattern wins that would
# have silently re-ignored the template. `git ls-files` would still show it as
# tracked, so the breakage would only surface the day someone re-added the file.
.env
.env.*
.env.local
!.env.example
